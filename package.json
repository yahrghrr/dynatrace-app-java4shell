{
  "name": "dynatrace-app-java4shell",
  "version": "0.0.0",
  "description": "A starting project with routing, fetching data, and charting",
  "scripts": {
    "build": "dt-app build --payload prod",
    "start": "dt-app dev --payload debug",
    "create:function": "dt-app function create",
    "create:action": "dt-app action create",
    "update": "dt-app update",
    "info": "dt-app info",
    "help": "dt-app help",
    "lint": "eslint .",
    "build:debug": "dt-app build --payload debug",
    "deploy:prod": "dt-app deploy --non-interactive --no-open --payload prod",
    "deploy:debug": "dt-app deploy --non-interactive --no-open --payload debug",
    "deploy:all": "npm run deploy:debug && npm run deploy:prod",
    "package:prod": "dt-app deploy --non-interactive --dry-run --payload prod",
    "package:debug": "dt-app deploy --non-interactive --dry-run --payload debug",
    "uninstall:prod": "dt-app uninstall --payload prod",
    "uninstall:debug": "dt-app uninstall --payload debug"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Sam JD",
  "license": "ISC",
  "dependencies": {
    "@dynatrace-sdk/app-environment": "^1.1.5",
    "@dynatrace-sdk/client-query": "^1.27.0",
    "@dynatrace-sdk/error-handlers": "^1.3.2",
    "@dynatrace-sdk/navigation": "^2.3.1",
    "@dynatrace-sdk/react-hooks": "^1.15.0",
    "@dynatrace-sdk/user-preferences": "^1.1.5",
    "@dynatrace/strato-components": "^3.15.0",
    "@dynatrace/strato-design-tokens": "^1.7.1",
    "@dynatrace/strato-icons": "^2.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-intl": "7.1.14",
    "react-router-dom": "^6.30.6"
  },
  "overrides": {
    "react-intl": {
      "typescript": "$typescript"
    },
    "@microsoft/eslint-plugin-sdl": {
      "eslint": "^10.0.0"
    },
    "eslint-plugin-react": {
      "eslint": "^10.0.0"
    }
  },
  "devDependencies": {
    "dt-app": "1.20.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.10.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
